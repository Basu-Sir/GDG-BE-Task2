# Database
DATABASE_URL=postgresql+asyncpg://workshop_app:local_dev_password@db:5432/workshops
# Sync URL used by Alembic migrations
DATABASE_URL_SYNC=postgresql+psycopg://workshop_app:local_dev_password@db:5432/workshops

# Mock notifier
MOCK_NOTIFIER_URL=http://mock-notifier:8001

# Worker configuration
WORKER_POLL_SECONDS=1
WORKER_BATCH_SIZE=10
WORKER_HTTP_TIMEOUT_SECONDS=2
WORKER_LEASE_SECONDS=15

# Retry policy
RETRY_BASE_SECONDS=1
RETRY_MAX_SECONDS=60

# Mock notifier mode: success | fail | timeout
MOCK_NOTIFY_MODE=success
MOCK_NOTIFY_TIMEOUT_SECONDS=10

# PostgreSQL (used by compose for DB init)
POSTGRES_USER=workshop_app
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=workshops
